{
  "name": "dsh-permission-compat",
  "version": "0.1.0",
  "private": true,
  "description": "Mode-aware redundant-escalation normalization patcher for DSH sandbox tools (pwsh/bash/fs).",
  "type": "module",
  "scripts": {
    "apply": "node tools/apply-dsh-permission-compat.mjs",
    "verify": "node tools/verify-dsh-permission-compat.mjs",
    "repair:session-control": "node tools/ensure-dsh-session-control-compat.mjs",
    "test:session-control": "node tools/test-session-control-compat.mjs",
    "apply:context-recovery": "node tools/apply-dsh-context-recovery-compat.mjs",
    "verify:context-recovery": "node tools/apply-dsh-context-recovery-compat.mjs --verify",
    "revert:context-recovery": "node tools/apply-dsh-context-recovery-compat.mjs --revert",
    "revert": "node tools/apply-dsh-permission-compat.mjs --revert",
    "start": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/dsh-web-safe.ps1"
  },
  "engines": {
    "node": ">=20"
  }
}
